<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.t3code.restart</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jeffbezos/restart-campfire.sh</string>
  </array>

  <!-- 4x per day at 04:00 / 10:00 / 16:00 / 22:00 local time.
       The backend has been observed to slide into a hard-to-use state within
       ~13 h of uninterrupted activity (mostly load and event-loop pressure
       from per-worktree VCS polling on a now ~100-worktree team mac mini),
       so a nightly restart is no longer enough — 6 h between restarts keeps
       the heap and fiber counts in their healthy band. Each restart is a
       ~30 s downtime; the four windows are picked to avoid peak focus hours
       (the 16:00 slot still hurts mid-day but is the lesser evil vs. running
       degraded until 22:00). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>4</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>10</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>16</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>22</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <!-- CRITICAL: without this, launchd sends SIGTERM/SIGINT to every child
       in the job's process group when the script exits. The script ends as
       soon as it confirms the backend is responding, which is moments
       AFTER it backgrounded `bun run dev` — so the freshly spawned backend
       gets killed right after startup (exit 130 = SIGINT). AbandonProcessGroup
       tells launchd to leave detached children alone. -->
  <key>AbandonProcessGroup</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/campfire-cron.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/campfire-cron.log</string>
</dict>
</plist>
