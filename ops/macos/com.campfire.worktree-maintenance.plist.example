<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.campfire.worktree-maintenance</string>
  <!--
    Worktrees on an external drive: macOS only lets binaries holding the removable-volumes
    permission read it, and launchd's /bin/sh does not, so start the script through Campfire's
    node. Without it the job exits 74 and logs each folder it cannot list.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/example/services/campfire/runtimes/node-v24.14.1-darwin-arm64/bin/node</string>
    <string>-e</string>
    <string>const r=require("child_process").spawnSync(process.argv[1],process.argv.slice(2),{stdio:"inherit"});process.exit(r.status??1)</string>
    <string>/Users/example/.local/libexec/campfire-worktree-maintenance.sh</string>
    <string>/Users/example/Library/Application Support/Campfire-staging</string>
    <string>7</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CAMPFIRE_TARGET_RETENTION_DAYS</key>
    <string>3</string>
    <key>CAMPFIRE_CARGO_TARGET_ROOTS</key>
    <string>/Volumes/Example/cargo-targets</string>
    <key>CAMPFIRE_CARGO_WORKTREE_ROOTS</key>
    <string>/Users/example/project/.claude/worktrees</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/example/Library/Logs/Campfire-staging/worktree-maintenance.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/example/Library/Logs/Campfire-staging/worktree-maintenance.stderr.log</string>
</dict>
</plist>
