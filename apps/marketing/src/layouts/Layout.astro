---
import { GITHUB_REPOSITORY_URL } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Campfire — Coding agents, together",
  description =
    "An open-source shared workspace for small, trusted teams running coding agents together.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://raw.githubusercontent.com/astraly-labs/campfire/staging/apps/marketing/public/og.png"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:image"
      content="https://raw.githubusercontent.com/astraly-labs/campfire/staging/apps/marketing/public/og.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <nav class="nav" aria-label="Main navigation">
      <div class="nav-inner">
        <a href="/" class="brand" aria-label="Campfire home">
          <span class="brand-mark" aria-hidden="true">✦</span>
          <span>Campfire</span>
        </a>
        <div class="nav-links">
          <a href="#product">Product</a>
          <a href="#trust">Trust model</a>
          <a href="#upstream">Built on T3 Code</a>
          <a class="nav-github" href={GITHUB_REPOSITORY_URL}>GitHub ↗</a>
        </div>
      </div>
    </nav>

    <main><slot /></main>

    <footer>
      <div class="footer-inner">
        <div>
          <strong>Campfire</strong>
          <span>Open source · MIT licensed</span>
        </div>
        <div class="footer-links">
          <a href={GITHUB_REPOSITORY_URL}>GitHub</a>
          <a href={`${GITHUB_REPOSITORY_URL}/blob/staging/SECURITY.md`}>Security</a>
          <a href={`${GITHUB_REPOSITORY_URL}/blob/staging/CONTRIBUTING.md`}>Contributing</a>
          <a href="https://github.com/pingdotgg/t3code">T3 Code ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0d0c0b;
    --panel: #151310;
    --panel-raised: #1b1814;
    --text: #f7f2e9;
    --muted: #aaa196;
    --dim: #766f67;
    --line: rgba(247, 242, 233, 0.1);
    --line-strong: rgba(247, 242, 233, 0.18);
    --ember: #ff7a3d;
    --ember-soft: #ffb07c;
    --green: #78c995;
    --font-sans: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% -20%, rgba(255, 122, 61, 0.12), transparent 42rem),
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
    background-size: auto, 48px 48px, 48px 48px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input {
    font: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--ember-soft);
    outline-offset: 4px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: rgba(13, 12, 11, 0.88);
    backdrop-filter: blur(18px);
  }

  .nav-inner,
  .footer-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav-inner {
    min-height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand-mark {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 8px;
    background: var(--ember);
    color: #1a0d07;
    font-size: 14px;
  }

  .nav-links,
  .footer-links {
    display: flex;
    align-items: center;
    gap: 24px;
    color: var(--muted);
    font-size: 14px;
  }

  .nav-links a:hover,
  .footer-links a:hover {
    color: var(--text);
  }

  .nav-github {
    padding: 9px 13px;
    border: 1px solid var(--line-strong);
    border-radius: 9px;
    color: var(--text);
  }

  footer {
    border-top: 1px solid var(--line);
    padding: 36px 0;
  }

  .footer-inner > div:first-child {
    display: grid;
    gap: 4px;
  }

  .footer-inner span {
    color: var(--dim);
    font-size: 13px;
  }

  @media (max-width: 760px) {
    .nav-inner,
    .footer-inner {
      width: min(100% - 32px, 1180px);
    }

    .nav-links a:not(.nav-github) {
      display: none;
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-links {
      flex-wrap: wrap;
      gap: 14px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
