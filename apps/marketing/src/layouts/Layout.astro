---
import { GITHUB_REPOSITORY_URL } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Campfire — Coding agents, together",
  description =
    "An open-source shared workspace for small, trusted teams running coding agents together.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://raw.githubusercontent.com/astraly-labs/campfire/staging/apps/marketing/public/og.png"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://raw.githubusercontent.com/astraly-labs/campfire/staging/apps/marketing/public/og.png"
    />
    <title>{title}</title>
  </head>
  <body>
    <nav class="nav" aria-label="Main navigation">
      <div class="nav-inner">
        <a href="/" class="brand" aria-label="Campfire home">
          <span class="brand-dot" aria-hidden="true"></span>
          <span>Campfire</span>
        </a>
        <div class="nav-links">
          <a href="#quickstart">Quickstart</a>
          <a class="nav-optional" href="#trust">Trust model</a>
          <a class="nav-optional" href="#upstream">Built on T3 Code</a>
          <a class="nav-github" href={GITHUB_REPOSITORY_URL}>GitHub ↗</a>
        </div>
      </div>
    </nav>

    <main><slot /></main>

    <footer>
      <div class="footer-inner">
        <div class="footer-copy">
          <strong>Campfire</strong>
          <span>
            MIT licensed · A thin fork of <a href="https://github.com/pingdotgg/t3code">T3 Code</a>
          </span>
        </div>
        <div class="footer-links">
          <a href={GITHUB_REPOSITORY_URL}>GitHub</a>
          <a href={`${GITHUB_REPOSITORY_URL}/blob/staging/SECURITY.md`}>Security</a>
          <a href={`${GITHUB_REPOSITORY_URL}/blob/staging/CONTRIBUTING.md`}>Contributing</a>
          <a href="https://github.com/pingdotgg/t3code">T3 Code ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0d0c0b;
    --surface: #151310;
    --text: #f7f2e9;
    --muted: #aaa196;
    --dim: #857d73;
    --line: rgba(247, 242, 233, 0.1);
    --line-strong: rgba(247, 242, 233, 0.2);
    --ember: #ff7a3d;
    --ember-soft: #ffb07c;
    --font-sans: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: ui-monospace, "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: var(--bg);
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition:
      color 120ms ease,
      border-color 120ms ease,
      background-color 120ms ease;
  }

  :focus-visible {
    outline: 2px solid var(--ember-soft);
    outline-offset: 4px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .nav-inner,
  .footer-inner {
    display: flex;
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav-inner {
    min-height: 62px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--ember);
  }

  .nav-links,
  .footer-links {
    display: flex;
    align-items: center;
    gap: 22px;
    color: var(--muted);
    font-size: 13px;
  }

  .nav-links a:hover,
  .footer-links a:hover,
  .footer-copy a:hover {
    color: var(--text);
  }

  .nav-github {
    padding: 8px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    color: var(--text);
  }

  .nav-github:hover {
    border-color: var(--ember-soft);
  }

  footer {
    padding: 34px 0;
    border-top: 1px solid var(--line);
  }

  .footer-copy {
    display: grid;
    gap: 4px;
  }

  .footer-copy strong {
    font-size: 14px;
  }

  .footer-copy span {
    color: var(--dim);
    font-size: 12px;
  }

  .footer-copy a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  @media (max-width: 760px) {
    .nav-inner,
    .footer-inner {
      width: min(100% - 32px, 1080px);
    }

    .nav-optional {
      display: none;
    }

    .nav-links {
      gap: 14px;
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-links {
      flex-wrap: wrap;
      gap: 14px 20px;
    }
  }

  @media (max-width: 390px) {
    .nav-links > a:first-child {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
