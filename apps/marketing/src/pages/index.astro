---
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";

const features = [
  {
    number: "01",
    title: "See who is here",
    body: "Live presence and typing state show who is viewing a task before two people steer the same run in different directions.",
  },
  {
    number: "02",
    title: "Discuss the run, in the run",
    body: "A durable team side conversation keeps questions, links, corrections, and decisions attached to the agent work they concern.",
  },
  {
    number: "03",
    title: "Bring in the right teammate",
    body: "Mentions, Take a Look, unread state, notifications, and a team inbox surface work without moving the context to another tool.",
  },
  {
    number: "04",
    title: "Keep long-running work visible",
    body: "Follow active threads and send, interrupt, redirect, resume, or archive agent work from another trusted machine.",
  },
] as const;

const providers = ["Codex", "Claude Code", "Cursor", "Grok Build", "OpenCode"] as const;
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> Open source · A thin fork of T3 Code</p>
      <h1>Run coding agents with your team, <em>not next to them.</em></h1>
      <p class="hero-lede">
        Campfire gives a small, trusted team one shared workspace for agent threads across projects
        and machines. See who is watching, discuss every run, and keep long-running work visible.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={`${GITHUB_REPOSITORY_URL}#quick-start`}>Get started</a>
        <a class="button secondary" href={GITHUB_REPOSITORY_URL}>View on GitHub ↗</a>
      </div>
    </div>

    <div class="product-frame" aria-label="Campfire collaboration workspace preview">
      <div class="window-bar">
        <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <span>northwind / api</span>
        <div class="presence" aria-label="Ada, Ben, and Priya are present">
          <span class="avatar ada">AO</span><span class="avatar ben">BR</span><span class="avatar priya">PS</span>
        </div>
      </div>
      <div class="workspace">
        <aside>
          <p class="aside-label">Active tasks</p>
          <div class="task active"><span class="status running"></span><div><strong>Fix flaky auth tests</strong><small>Claude Code · working</small></div></div>
          <div class="task"><span class="status review"></span><div><strong>Review billing refactor</strong><small>Codex · needs review</small></div></div>
          <div class="task"><span class="status done"></span><div><strong>Document rate limits</strong><small>OpenCode · done</small></div></div>
          <div class="inbox-row"><span>Team inbox</span><b>3</b></div>
        </aside>
        <div class="thread">
          <div class="thread-head">
            <div><small>fix/auth-timeout</small><strong>Fix flaky auth tests</strong></div>
            <span class="live-pill">● Agent working</span>
          </div>
          <div class="messages">
            <div class="agent-message">
              <span class="agent-mark">C</span>
              <div><small>Claude Code</small><p>I found a race between session refresh and the first authenticated request. I’m adding a focused regression test at the shared boundary.</p></div>
            </div>
            <div class="activity"><span></span> Editing <code>EnvironmentAuth.ts</code></div>
          </div>
        </div>
        <aside class="side-thread">
          <div class="side-title"><span>Team discussion</span><b>2</b></div>
          <div class="human-message"><span class="avatar ben">BR</span><div><strong>Ben</strong><p>This also explains yesterday’s reconnect failure.</p></div></div>
          <div class="human-message"><span class="avatar ada">AO</span><div><strong>Ada</strong><p><span class="mention">@Priya</span> take a look at the session boundary?</p></div></div>
          <div class="composer">Reply to your team…</div>
        </aside>
      </div>
    </div>
  </section>

  <section id="product" class="features section-shell">
    <div class="section-heading">
      <p class="eyebrow">Built for shared agent work</p>
      <h2>The context stays where the work happens.</h2>
    </div>
    <div class="feature-grid">
      {features.map((feature) => (
        <article>
          <span>{feature.number}</span>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="trust" class="trust section-shell">
    <div>
      <p class="eyebrow">The boundary is intentional</p>
      <h2>Designed for teams that already trust each other.</h2>
    </div>
    <div class="trust-copy">
      <p>
        Campfire has no RBAC, tenant isolation, or granular permissions. Everyone connected can see
        and act on shared agent work.
      </p>
      <p>
        Run it on a dedicated host behind a private network, and only invite people you would
        already trust with repository access. If you need isolation between users, Campfire is not
        the right tool.
      </p>
      <a href={`${GITHUB_REPOSITORY_URL}/blob/staging/SECURITY.md`}>Read the security model →</a>
    </div>
  </section>

  <section class="providers section-shell">
    <div>
      <p class="eyebrow">Bring your provider</p>
      <h2>Keep the coding agents you already use.</h2>
    </div>
    <div class="provider-list">
      {providers.map((provider) => <span>{provider}</span>)}
    </div>
  </section>

  <section id="upstream" class="upstream section-shell">
    <div class="upstream-mark" aria-hidden="true">T3</div>
    <div>
      <p class="eyebrow">Campfire stands on T3 Code</p>
      <h2>Built on an excellent open-source foundation.</h2>
      <p>
        T3 Code created the provider integrations, remote architecture, and core web, desktop, and
        mobile clients underneath Campfire. We add a small-team collaboration layer while changing
        as little else as possible, so rebasing onto upstream stays straightforward.
      </p>
      <p class="independent">
        Campfire is an independent community fork. It is not affiliated with, endorsed by, or
        supported by the T3 Code maintainers.
      </p>
      <div class="upstream-links">
        <a href="https://github.com/pingdotgg/t3code">Star T3 Code ↗</a>
        <a href={`${GITHUB_REPOSITORY_URL}/blob/staging/NOTICE.md`}>Read the attribution →</a>
      </div>
    </div>
  </section>

  <section class="cta section-shell">
    <p class="eyebrow">Source-first</p>
    <h2>Bring the team around the same fire.</h2>
    <p>Clone Campfire, connect an authenticated provider, and follow the trusted-team deployment guide when you are ready to share it.</p>
    <div class="hero-actions">
      <a class="button primary" href={`${GITHUB_REPOSITORY_URL}#quick-start`}>Get started on GitHub</a>
      <a class="button secondary" href={`${GITHUB_REPOSITORY_URL}/blob/staging/docs/operations/campfire-mac-mini.md`}>Deployment guide</a>
    </div>
  </section>
</Layout>

<style>
  .hero,
  .section-shell {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .hero {
    padding: clamp(88px, 11vw, 148px) 0 96px;
  }

  .hero-copy {
    max-width: 940px;
  }

  .eyebrow {
    color: var(--ember-soft);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .eyebrow span {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin: 0 7px 1px 0;
    border-radius: 50%;
    background: var(--ember);
  }

  h1 {
    max-width: 1040px;
    margin-top: 25px;
    font-size: clamp(3.2rem, 7.8vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.94;
  }

  h1 em {
    color: var(--muted);
    font-style: normal;
  }

  .hero-lede {
    max-width: 720px;
    margin-top: 32px;
    color: var(--muted);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
  }

  .button:hover {
    border-color: rgba(255, 176, 124, 0.6);
  }

  .button.primary {
    border-color: var(--ember);
    background: var(--ember);
    color: #1b0d07;
  }

  .button.secondary {
    background: rgba(255, 255, 255, 0.025);
  }

  .product-frame {
    margin-top: 72px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: #11100e;
    box-shadow: 0 36px 100px rgba(0, 0, 0, 0.42);
  }

  .window-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 54px;
    align-items: center;
    padding: 0 18px;
    border-bottom: 1px solid var(--line);
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .window-dots,
  .presence {
    display: flex;
    align-items: center;
  }

  .window-dots {
    gap: 6px;
  }

  .window-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .presence {
    justify-content: flex-end;
  }

  .avatar {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border: 2px solid #11100e;
    border-radius: 50%;
    color: #18130f;
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 600;
  }

  .presence .avatar + .avatar {
    margin-left: -6px;
  }

  .ada { background: #ffb07c; }
  .ben { background: #87b9ff; }
  .priya { background: #9ddcae; }

  .workspace {
    display: grid;
    min-height: 470px;
    grid-template-columns: 230px minmax(0, 1fr) 285px;
  }

  .workspace > * + * {
    border-left: 1px solid var(--line);
  }

  aside,
  .thread {
    min-width: 0;
  }

  aside {
    padding: 22px 14px;
  }

  .aside-label,
  .thread-head small,
  .agent-message small {
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .task {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr);
    gap: 10px;
    margin-top: 8px;
    padding: 12px 10px;
    border-radius: 9px;
  }

  .task.active {
    background: rgba(255, 122, 61, 0.09);
  }

  .task strong,
  .task small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .task strong {
    font-size: 12px;
    font-weight: 500;
  }

  .task small {
    margin-top: 4px;
    color: var(--dim);
    font-size: 10px;
  }

  .status {
    width: 6px;
    height: 6px;
    margin-top: 5px;
    border-radius: 50%;
  }

  .running { background: var(--ember); }
  .review { background: #f1c46a; }
  .done { background: var(--green); }

  .inbox-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 22px;
    padding: 12px 10px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 12px;
  }

  .inbox-row b,
  .side-title b {
    display: grid;
    min-width: 19px;
    height: 19px;
    place-items: center;
    border-radius: 999px;
    background: var(--ember);
    color: #190c06;
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .thread-head {
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    padding: 0 22px;
    border-bottom: 1px solid var(--line);
  }

  .thread-head strong,
  .thread-head small {
    display: block;
  }

  .thread-head strong {
    margin-top: 3px;
    font-size: 14px;
  }

  .live-pill {
    padding: 6px 9px;
    border: 1px solid rgba(255, 122, 61, 0.25);
    border-radius: 999px;
    color: var(--ember-soft);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .messages {
    padding: 38px 30px;
  }

  .agent-message {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 12px;
  }

  .agent-mark {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .agent-message p {
    max-width: 520px;
    margin-top: 8px;
    color: #d6d0c7;
    font-size: 13px;
    line-height: 1.7;
  }

  .activity {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 32px 0 0 42px;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .activity span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ember);
  }

  .side-thread {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.012);
  }

  .side-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4px 18px;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    font-weight: 600;
  }

  .human-message {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 10px;
    padding: 18px 4px 0;
  }

  .human-message strong {
    display: block;
    font-size: 11px;
  }

  .human-message p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }

  .mention { color: var(--ember-soft); }

  .composer {
    margin-top: auto;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 9px;
    color: var(--dim);
    font-size: 10px;
  }

  .section-shell {
    padding: 112px 0;
    border-top: 1px solid var(--line);
  }

  .section-heading {
    max-width: 680px;
  }

  h2 {
    margin-top: 16px;
    font-size: clamp(2.25rem, 5vw, 4.4rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.02;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 68px;
    border-top: 1px solid var(--line);
  }

  .feature-grid article {
    min-height: 260px;
    padding: 28px 24px 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .feature-grid article + article {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .feature-grid article > span {
    color: var(--ember-soft);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .feature-grid h3 {
    margin-top: 42px;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .feature-grid p,
  .upstream p,
  .cta > p:not(.eyebrow) {
    margin-top: 16px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .trust,
  .providers,
  .upstream {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
    gap: clamp(56px, 9vw, 130px);
    align-items: start;
  }

  .trust-copy {
    padding-top: 28px;
  }

  .trust-copy p {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.7;
  }

  .trust-copy p + p {
    margin-top: 20px;
  }

  .trust-copy a,
  .upstream-links a {
    display: inline-block;
    margin-top: 28px;
    color: var(--ember-soft);
    font-size: 14px;
    font-weight: 500;
  }

  .provider-list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .provider-list span {
    padding: 17px 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .upstream {
    grid-template-columns: 260px minmax(0, 1fr);
  }

  .upstream-mark {
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 24px;
    background: var(--panel);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 54px;
    letter-spacing: -0.08em;
  }

  .upstream p {
    max-width: 720px;
    font-size: 16px;
  }

  .upstream .independent {
    color: var(--dim);
    font-size: 13px;
  }

  .upstream-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .cta {
    padding-bottom: 140px;
    text-align: center;
  }

  .cta h2,
  .cta > p {
    max-width: 760px;
    margin-right: auto;
    margin-left: auto;
  }

  .cta .hero-actions {
    justify-content: center;
  }

  @media (max-width: 980px) {
    .workspace {
      grid-template-columns: 210px minmax(0, 1fr);
    }

    .side-thread {
      display: none;
    }

    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .feature-grid article:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .trust,
    .providers {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .hero,
    .section-shell {
      width: min(100% - 32px, 1180px);
    }

    .hero {
      padding-top: 72px;
    }

    h1 {
      font-size: clamp(3rem, 15vw, 4.8rem);
    }

    .product-frame {
      margin-top: 52px;
    }

    .window-bar {
      grid-template-columns: 1fr auto;
    }

    .window-bar > span {
      display: none;
    }

    .workspace {
      min-height: 430px;
      grid-template-columns: 1fr;
    }

    .workspace > aside:first-child {
      display: none;
    }

    .workspace > * + * {
      border-left: 0;
    }

    .thread-head {
      padding: 0 16px;
    }

    .messages {
      padding: 30px 20px;
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }

    .feature-grid article,
    .feature-grid article + article {
      min-height: auto;
      padding: 28px 0 36px;
      border-left: 0;
    }

    .feature-grid h3 {
      margin-top: 24px;
    }

    .upstream {
      grid-template-columns: 1fr;
    }

    .upstream-mark {
      width: 110px;
      border-radius: 18px;
      font-size: 30px;
    }

    .section-shell {
      padding: 80px 0;
    }
  }
</style>
