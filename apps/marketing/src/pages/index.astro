---
import productScreenshot from "../../../../docs/assets/campfire-app-team-discussion.png?url";
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";

const capabilities = [
  {
    title: "Presence and typing state",
    body: "See who is already viewing a task before two people steer the same run in opposite directions.",
  },
  {
    title: "Durable side discussions",
    body: "Keep questions, links, and corrections attached to the agent thread that produced them.",
  },
  {
    title: "Mentions and a team inbox",
    body: "Bring the right teammate into a specific run. Unread state and notifications follow them; the context does not move.",
  },
  {
    title: "Shared controls",
    body: "Send, interrupt, redirect, resume, or archive long-running agent work from any trusted machine on the team.",
  },
] as const;

const quickstart = `git clone https://github.com/astraly-labs/campfire.git
cd campfire
corepack enable
corepack pnpm install --frozen-lockfile
corepack pnpm dev`;
---

<Layout>
  <section class="hero section-shell">
    <div class="hero-copy">
      <p class="eyebrow">Open source · A thin fork of T3 Code</p>
      <h1>Run coding agents with your team, not next to them.</h1>
      <p class="lede">
        Campfire is a shared workspace for small, fully trusted teams running coding agents across
        projects and machines. Presence, side discussions, mentions, and unread state live directly
        on the agent threads you already run.
      </p>
      <div class="actions">
        <a class="button primary" href={GITHUB_REPOSITORY_URL}>View on GitHub</a>
        <a class="button secondary" href="#quickstart">Read the quickstart</a>
      </div>
    </div>

    <aside class="near-fold-credit" aria-labelledby="near-fold-credit-title">
      <p class="eyebrow" id="near-fold-credit-title">Built on T3 Code</p>
      <p>
        The provider integrations, remote architecture, worktrees, and core clients are upstream
        work by <a href="https://github.com/juliusmarminge">Julius Marminge</a>,
        {" "}<a href="https://github.com/t3dotgg">Theo Browne</a>, the pingdotgg maintainers, and
        contributors.
      </p>
      <a class="text-link" href="https://github.com/pingdotgg/t3code">Visit T3 Code ↗</a>
      <small>Campfire is independently maintained and is not endorsed by T3 Tools Inc.</small>
    </aside>
  </section>

  <figure class="product-proof page-shell">
    <div class="screenshot-frame">
      <img
        src={productScreenshot}
        alt="Campfire showing a coding agent thread with a teammate discussion open beside it"
        width="1600"
        height="1000"
        loading="eager"
        decoding="async"
      />
    </div>
    <figcaption>
      One agent thread, one durable team discussion. The run and the decisions around it stay in
      the same place.
    </figcaption>
  </figure>

  <section id="product" class="capabilities section-shell">
    <header class="section-intro">
      <p class="eyebrow">The team layer</p>
      <h2>Shared context without replacing your agent tools.</h2>
    </header>

    <dl>
      {capabilities.map((capability) => (
        <div>
          <dt>{capability.title}</dt>
          <dd>{capability.body}</dd>
        </div>
      ))}
    </dl>

    <p class="upstream-note">
      Codex, Claude Code, Cursor, Grok Build, and OpenCode support, along with remote sessions,
      worktrees, and the web, desktop, and early mobile clients, come from T3 Code.
    </p>
  </section>

  <section id="quickstart" class="quickstart section-shell">
    <div class="section-intro">
      <p class="eyebrow">Source first</p>
      <h2>Run Campfire from source.</h2>
      <p>
        Campfire does not have a stable packaged release yet. You need Node.js 24.13.1 or newer
        within major 24 and at least one T3 Code provider already installed and authenticated.
      </p>
      <div class="inline-links">
        <a href="https://github.com/pingdotgg/t3code#installation">Provider setup ↗</a>
        <a href={`${GITHUB_REPOSITORY_URL}/blob/staging/docs/operations/campfire-mac-mini.md`}>
          Trusted-team deployment ↗
        </a>
      </div>
    </div>

    <div class="code-block">
      <div class="code-label">Clone and start the development server</div>
      <pre><code>{quickstart}</code></pre>
      <p>Open the pairing URL printed by the server. Local development state stays in <code>.t3</code>.</p>
    </div>
  </section>

  <section id="trust" class="trust section-shell">
    <div class="boundary">
      <p class="eyebrow">Read this before deploying</p>
      <h2>Campfire has no permissions model. That is the design.</h2>
      <div class="boundary-copy">
        <p>
          There is no RBAC, tenant isolation, or per-user workspace permission. Anyone admitted to
          an instance can see and act on every shared agent thread and every project the Campfire
          service can reach.
        </p>
        <p>
          Campfire authenticates teammates and records who did what. It does not authorize them
          differently. Authentication is not isolation.
        </p>
        <p>
          Run it on a dedicated host behind a network boundary you control, use an explicit identity
          allowlist, and invite only people you would already trust with repository access. If you
          need isolation between users or teams, Campfire is the wrong tool.
        </p>
        <a class="text-link" href={`${GITHUB_REPOSITORY_URL}/blob/staging/SECURITY.md`}>
          Read the security model →
        </a>
      </div>
    </div>
  </section>

  <section id="upstream" class="upstream section-shell">
    <header class="section-intro">
      <p class="eyebrow">Upstream</p>
      <h2>T3 Code did the hard part.</h2>
    </header>
    <div class="upstream-copy">
      <p>
        Campfire exists because <a href="https://github.com/pingdotgg/t3code">T3 Code</a> built an
        excellent open-source foundation for driving Codex, Claude Code, Cursor, Grok Build, and
        OpenCode from web, desktop, and mobile clients. The architecture, provider integrations,
        remote workflow, worktree handling, and substantial portions of this repository are the work
        of <a href="https://github.com/juliusmarminge">Julius Marminge</a>,
        {" "}<a href="https://github.com/t3dotgg">Theo Browne</a>, the T3 Code maintainers, and
        {" "}<a href="https://github.com/pingdotgg/t3code/graphs/contributors">upstream contributors</a>.
      </p>
      <p>
        Our strategy is minimal divergence. We rebase onto upstream regularly, avoid renames and
        rewrites that create conflicts for no user-visible gain, contribute broadly useful fixes
        upstream when practical, and keep Campfire-only behavior at narrow boundaries.
      </p>
      <p class="independent">
        Campfire is independently maintained and is not affiliated with, sponsored by, or endorsed
        by T3 Tools Inc. T3 Code and related names and marks belong to their respective owners.
      </p>
      <div class="inline-links">
        <a href="https://github.com/pingdotgg/t3code">Star T3 Code ↗</a>
        <a href={`${GITHUB_REPOSITORY_URL}/blob/staging/NOTICE.md`}>Read NOTICE.md →</a>
        <a href={`${GITHUB_REPOSITORY_URL}/blob/staging/docs/UPSTREAM.md`}>
          Read our upstream policy →
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-shell,
  .section-shell {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
  }

  .section-shell {
    padding: clamp(72px, 9vw, 112px) 0;
    border-top: 1px solid var(--line);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.65fr);
    gap: clamp(48px, 8vw, 112px);
    align-items: end;
    padding-top: clamp(96px, 13vw, 160px);
    border-top: 0;
  }

  .hero-copy {
    max-width: 720px;
  }

  .eyebrow {
    color: var(--ember-soft);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  h1,
  h2 {
    text-wrap: balance;
  }

  h1 {
    max-width: 700px;
    margin-top: 24px;
    font-size: clamp(2.75rem, 6.4vw, 5.15rem);
    font-weight: 560;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  h2 {
    margin-top: 14px;
    font-size: clamp(2rem, 4vw, 3.65rem);
    font-weight: 540;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .lede {
    max-width: 650px;
    margin-top: 28px;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.7;
  }

  .actions,
  .inline-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 22px;
  }

  .actions {
    margin-top: 32px;
  }

  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    font-size: 14px;
    font-weight: 650;
  }

  .button:hover {
    border-color: var(--ember-soft);
  }

  .button.primary {
    border-color: var(--ember);
    background: var(--ember);
    color: #1b0d07;
  }

  .button.primary:hover {
    background: #ff8c55;
  }

  .button:active {
    transform: translateY(1px);
  }

  .near-fold-credit {
    padding-top: 22px;
    border-top: 1px solid var(--line-strong);
  }

  .near-fold-credit > p:not(.eyebrow) {
    margin-top: 18px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .near-fold-credit p a,
  .upstream-copy p a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .near-fold-credit small {
    display: block;
    margin-top: 18px;
    color: var(--dim);
    font-size: 12px;
    line-height: 1.5;
  }

  .text-link,
  .inline-links a {
    color: var(--ember-soft);
    font-size: 14px;
    font-weight: 600;
  }

  .text-link {
    display: inline-block;
    margin-top: 20px;
  }

  .text-link:hover,
  .inline-links a:hover,
  .near-fold-credit p a:hover,
  .upstream-copy p a:hover {
    color: var(--text);
  }

  .product-proof {
    padding-bottom: clamp(72px, 9vw, 112px);
  }

  .screenshot-frame {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: #f8f8f7;
  }

  .screenshot-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    max-width: 680px;
    margin-top: 18px;
    color: var(--dim);
    font-size: 13px;
    line-height: 1.6;
  }

  .section-intro {
    max-width: 720px;
  }

  .section-intro > p:not(.eyebrow) {
    max-width: 640px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.7;
  }

  .capabilities dl {
    margin-top: 56px;
    border-top: 1px solid var(--line);
  }

  .capabilities dl > div {
    display: grid;
    grid-template-columns: minmax(200px, 0.65fr) minmax(0, 1fr);
    gap: 24px 48px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .capabilities dt {
    font-size: 16px;
    font-weight: 650;
  }

  .capabilities dd,
  .upstream-note {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .upstream-note {
    max-width: 740px;
    margin-top: 30px;
  }

  .quickstart,
  .upstream {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(420px, 1.15fr);
    gap: clamp(48px, 8vw, 108px);
    align-items: start;
  }

  .quickstart .inline-links {
    margin-top: 24px;
  }

  .code-block {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--surface);
  }

  .code-label {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  pre {
    overflow-x: auto;
    padding: 22px 20px;
    color: #ddd6cc;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.8;
    tab-size: 2;
  }

  .code-block > p {
    padding: 14px 16px;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font-size: 12px;
    line-height: 1.6;
  }

  .code-block p code {
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .boundary {
    padding-left: clamp(22px, 4vw, 44px);
    border-left: 2px solid var(--ember);
  }

  .boundary h2 {
    max-width: 760px;
  }

  .boundary-copy {
    max-width: 750px;
    margin-top: 34px;
  }

  .boundary-copy p,
  .upstream-copy p {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.75;
  }

  .boundary-copy p + p,
  .upstream-copy p + p {
    margin-top: 18px;
  }

  .upstream-copy {
    padding-top: 26px;
  }

  .upstream-copy .independent {
    color: var(--dim);
    font-size: 13px;
  }

  .upstream-copy .inline-links {
    margin-top: 28px;
  }

  @media (max-width: 860px) {
    .hero,
    .quickstart,
    .upstream {
      grid-template-columns: 1fr;
    }

    .hero {
      align-items: start;
    }

    .near-fold-credit {
      max-width: 640px;
    }
  }

  @media (max-width: 620px) {
    .page-shell,
    .section-shell {
      width: min(100% - 32px, 1080px);
    }

    h1 {
      font-size: clamp(2.65rem, 14vw, 4rem);
    }

    .actions {
      align-items: stretch;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .capabilities dl > div {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .boundary {
      padding-left: 20px;
    }
  }
</style>
